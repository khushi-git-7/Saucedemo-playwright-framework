# Copy to `.env` and edit as needed:  cp .env.example .env
# `.env` is git-ignored. Every value below is optional - the defaults shown
# here are what the framework uses when the variable is not set.

# --- Application under test ---------------------------------------------
BASE_URL=https://www.saucedemo.com/

# --- Credentials ---------------------------------------------------------
# SauceDemo is a public demo app; these are its published demo accounts.
# Real projects would inject these from a secret store / CI secrets.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
SAUCE_LOCKED_USER=locked_out_user
SAUCE_PROBLEM_USER=problem_user

# --- Browser -------------------------------------------------------------
# chromium | firefox | webkit
BROWSER=chromium
# HEADED=1 runs with a visible browser window (default: headless)
HEADED=0
# Artificial delay between Playwright actions, in ms. Debug aid only.
SLOW_MO=0
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# --- Timeouts (milliseconds) --------------------------------------------
TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# --- Failure artifacts: on | off | retain-on-failure ---------------------
SCREENSHOT=retain-on-failure
TRACE=retain-on-failure
VIDEO=retain-on-failure

# --- API test layer ------------------------------------------------------
API_BASE_URL=https://jsonplaceholder.typicode.com
# requests timeout, in seconds
API_TIMEOUT=15
# Upper bound asserted by the API response-time test, in milliseconds
API_MAX_RESPONSE_MS=3000
